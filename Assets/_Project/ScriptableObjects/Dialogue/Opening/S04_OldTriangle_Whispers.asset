  m_Script: {fileID: 11500000, guid: 17272073cbcc03d4b82d101449fb470b, type: 3}
  m_Name: S04_OldTriangle_Whispers
  m_EditorClassIdentifier: Assembly-CSharp::ProjectCircle.Systems.Dialogue
  speaker: Old Triangle
  lines:
  - Do you hear that? The whispers... they're louder now.
  - Something is reaching into us. Taking control. I think it lives in our vertices.
  - The more corners you have, the tighter it holds you. But you... you have none.
  - It can't touch you. You might be the only one who can face it.
