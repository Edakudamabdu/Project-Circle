  m_Script: {fileID: 11500000, guid: 17272073cbcc03d4b82d101449fb470b, type: 3}
  m_Name: S03_OldTriangle_PitMeeting
  m_EditorClassIdentifier: Assembly-CSharp::ProjectCircle.Systems.Dialogue
  speaker: Old Triangle
  lines:
  - Another one thrown down here...
  - No corners at all? Hm. Come closer, little one.
  - This pit is where they throw what they don't want.
  - I've been here a long time. Long enough to stop counting.
