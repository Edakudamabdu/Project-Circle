  m_Script: {fileID: 11500000, guid: 6431c9ca15c76344eab15b3180391517, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectCircle.Systems.RegionInfo
  regionName: Scalene Slums
  showNameOnEnter: 1
  devCape: 1
  devAbilities: 3
  devFlags: []
  notes: "The lowest-rank village. Its residents are SCALENE triangles (uneven, the
    least aggressive), corrupted\n(Enemies/Corrupted Residents hides once Freed.Slums
    is set; the freed villagers show instead).\nEdge: chasers + a Charger (dash).
    Square: + PARRY string. Lower streets: Sentry, orb caster, Swarm (parry).\nThe
    Mirror is in the quiet stretch before the Warden's Gate. Raised alcove: crumbling
    wall (dash) \u2192 the crack into the Fissure.\nExits: west opening \u2192 Graveyard,
    east through the Warden's Gate \u2192 Base Warden."
