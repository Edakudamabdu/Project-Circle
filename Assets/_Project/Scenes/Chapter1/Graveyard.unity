  m_EditorClassIdentifier: Assembly-CSharp::ProjectCircle.Systems.RegionInfo
  regionName: Broken Vertex Graveyard
  showNameOnEnter: 1
  devCape: 1
  devAbilities: 2
  devFlags: []
  notes: "First fights with the cape (blade + pogo only): chasers, a Spire pit, a
    Splitter.\nEnds with the Runner's String (+ DASH), a gap that needs it, and the
    first Wedge Charger.\nThe ruined doorway (sealed by the Triangle Mould) leads
    to the secret Shrine of the First Break.\nExits: west opening \u2192 Hall of
    Strings, east opening \u2192 Scalene Slums. No Mirror here."
