  m_Script: {fileID: 11500000, guid: 6431c9ca15c76344eab15b3180391517, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectCircle.Systems.RegionInfo
  regionName: The Twin Isosceles
  showNameOnEnter: 1
  ambience: {fileID: 8300000, guid: 07318c1b0feb37844b8da272cc6bf122, type: 3}
  ambienceVolume: 0.35
  devCape: 1
  devAbilities: 15
  devFlags:
  - Seal.Warden
  notes: "BOSS 2 \xB7 The Twin Isosceles (Iso and Skelos). Press Play here to start
    just outside the arena; walk right to begin.\nPhase 1 (both): Pincer Charge,
    Mirror Slam, Measuring Line, Passing Orb (parry it back), the Compass; they Rebalance
    once.\nPhase 2 (one falls): the survivor warps scalene, turns crimson, fights
    alone and faster.\nReward: Seal.Twins (Vertex Seal II). The east opening (gate)
    leads back to the Terraces."
